generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTH
// ============================================

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  password      String
  name          String
  role          String   @default("WARGA") // WARGA, KETUA_RT, SEKRETARIS, BENDAHARA, PENGURUS
  status        String   @default("PENDING") // PENDING, ACTIVE, REJECTED, INACTIVE
  phone         String?
  address       String?
  familyId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  family        Family?           @relation(fields: [familyId], references: [id])
  rondaLogs     RondaLog[]
  fines         Fine[]
  letters       Letter[]
  createdJimpitan JimpitanLog[]   @relation("JimpitanCreator")
  announcements Announcement[]    @relation("AnnouncementAuthor")
  familyMember  FamilyMember?
}

// ============================================
// FAMILY (KELUARGA) — per Kepala Keluarga
// ============================================

model Family {
  id              String   @id @default(cuid())
  familyHead      String   // Nama Kepala Keluarga (denormalized for quick display)
  address         String
  rondaGroupId    String?  // FK ke RondaGroup
  isActive        Boolean  @default(true)

  // Jimpitan settings per KK
  jimpitanType    String   @default("HARIAN")  // HARIAN (Rp.1000/malam), BULANAN (custom)
  jimpitanAmount  Int      @default(1000)       // Harian=1000, Bulanan=custom (30000/50000/dll)

  // Ronda status per KK
  rondaStatus     String   @default("AKTIF")   // AKTIF (ikut ronda), KASEPUHAN (dispensasi), BAYAR_IURAN (bayar pengganti)
  rondaFee        Int      @default(0)          // Iuran ronda per selapanan untuk BAYAR_IURAN

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  rondaGroup      RondaGroup?   @relation(fields: [rondaGroupId], references: [id])
  jimpitanLogs    JimpitanLog[]
  jimpitanEnrollment JimpitanEnrollment?
  rondaLogs       RondaLog[]
  fines           Fine[]
  shortages       JimpitanShortage[]
  familyMembers   FamilyMember[]
  levyItems       CustomLevyItem[]
}

// ============================================
// FAMILY MEMBER — anggota keluarga (demografi lengkap)
// ============================================

model FamilyMember {
  id                String   @id @default(cuid())
  familyId          String
  userId            String?  @unique // opsional: terhubung ke akun User jika punya HP
  fullName          String
  nik               String?  // Nomor Induk Kependudukan
  gender            String   // LAKI_LAKI, PEREMPUAN
  relationship      String   // KEPALA_KELUARGA, SUAMI_ISTRI, ANAK, MENANTU, CUCU, ORANG_TUA, MERTUA, FAMILI_LAIN, PEMBANTU, LAINNYA
  maritalStatus     String?  // BELUM_KAWIN, KAWIN, CERAI_HIDUP, CERAI_MATI
  birthPlace        String?  // Tempat lahir
  birthDate         String?  // YYYY-MM-DD
  education         String?  // TIDAK_SEKOLAH, SD, SMP, SMA, D1, D2, D3, S1, S2, S3
  citizenship       String   @default("WNI") // WNI, WNA
  occupation        String?  // Pekerjaan
  isFamilyHead      Boolean  @default(false) // penanda cepat KK
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  family            Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user              User?    @relation(fields: [userId], references: [id])
}

// ============================================
// RONDA (SISKAMLING) - 7 Grup, Malam Minggu s/d Malam Sabtu
// ============================================

model RondaGroup {
  id          String   @id @default(cuid())
  name        String   @unique // Grup 1 - Malam Minggu, dst.
  dayOfWeek   Int      // 0=Minggu, 1=Senin, 2=Selasa, 3=Rabu, 4=Kamis, 5=Jumat, 6=Sabtu
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  families       Family[]          // KK yang terdaftar di grup ini
  schedules      RondaSchedule[]
  jimpitanLogs   JimpitanLog[]    // jimpitan yang ditarik grup ini
}

model RondaSchedule {
  id          String   @id @default(cuid())
  groupId     String
  date        String   // YYYY-MM-DD
  shift       String   @default("MALAM") // MALAM, PAGI
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group       RondaGroup @relation(fields: [groupId], references: [id])
  logs        RondaLog[]
}

model RondaLog {
  id          String   @id @default(cuid())
  scheduleId  String
  userId      String
  familyId    String
  status      String   @default("HADIR") // HADIR, TIDAK_HADIR, IZIN
  notes       String?
  createdAt   DateTime @default(now())

  schedule    RondaSchedule @relation(fields: [scheduleId], references: [id])
  user        User          @relation(fields: [userId], references: [id])
  family      Family        @relation(fields: [familyId], references: [id])
}

// ============================================
// JIMPITAN (IURAN HARIAN)
// ============================================

// Enrollmen: KK yang memilih bayar harian
model JimpitanEnrollment {
  id          String   @id @default(cuid())
  familyId    String   @unique
  isActive    Boolean  @default(true)
  enrolledAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  family      Family   @relation(fields: [familyId], references: [id])
}

// Log harian: catatan per KK per hari
model JimpitanLog {
  id              String   @id @default(cuid())
  familyId        String
  date            String   // YYYY-MM-DD
  expectedAmount  Int      // yang seharusnya dibayar (misal 1000)
  paidAmount      Int      @default(0) // yang dibayar: 0, 500, 1000
  shortage        Int      @default(0) // expectedAmount - paidAmount
  groupId         String?  // grup ronda yang narik (otomatis dari hari)
  selapananId     String?  // periode selapanan
  notes           String?
  createdBy       String   // userId yang mencatat
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  family          Family   @relation(fields: [familyId], references: [id])
  creator         User     @relation("JimpitanCreator", fields: [createdBy], references: [id])
  group           RondaGroup? @relation(fields: [groupId], references: [id])

  @@unique([familyId, date]) // satu entry per KK per hari
}

// Kekurangan jimpitan per KK per Selapanan
model JimpitanShortage {
  id              String   @id @default(cuid())
  familyId        String
  selapananId     String
  totalShortage   Int      @default(0) // total kekurangan di periode ini
  isSettled       Boolean  @default(false) // apakah sudah dibayar di selapanan
  settledAmount   Int      @default(0) // berapa yang dibayar saat selapanan
  carriedOver     Boolean  @default(false) // apakah carry over ke selapanan berikutnya
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  family          Family     @relation(fields: [familyId], references: [id])
  selapanan       Selapanan  @relation(fields: [selapananId], references: [id])

  @@unique([familyId, selapananId]) // satu entry per KK per selapanan
}

// ============================================
// SELAPANAN (RAPAT 35 HARI)
// ============================================

model Selapanan {
  id              String   @id @default(cuid())
  number          Int      @default(0) // Nomor selapanan ke-berapa
  periodeStart    String   // YYYY-MM-DD
  periodeEnd      String   // YYYY-MM-DD
  meetingDate     String   // YYYY-MM-DD (Sabtu malam Minggu Pon)
  meetingLocation String?
  status          String   @default("UPCOMING") // UPCOMING, COMPLETED, CANCELLED

  // Financial recap
  jimpitanDaily   Int      @default(0)  // Total jimpitan harian terkumpul
  jimpitanMonthly Int      @default(0)  // Total iuran bulanan terkumpul
  rondaFeeTotal   Int      @default(0)  // Total iuran ronda terkumpul
  shortagePaid    Int      @default(0)  // Total kurangan jimpitan yang dibayar
  finePaid        Int      @default(0)  // Total denda yang dibayar
  levyPaid        Int      @default(0)  // Total tarikan lain yang dibayar
  otherIncome     Int      @default(0)  // Pemasukan lain
  totalIncome     Int      @default(0)  // Total semua pemasukan

  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  details         SelapananDetail[]
  transactions    Transaction[]
  shortages       JimpitanShortage[]
  levyPayments    CustomLevyPayment[]
}

model SelapananDetail {
  id              String   @id @default(cuid())
  selapananId     String
  agenda          String
  decisions       String?  // Keputusan rapat
  notes           String?
  createdAt       DateTime @default(now())

  selapanan       Selapanan @relation(fields: [selapananId], references: [id])
}

// ============================================
// KEUANGAN
// ============================================

model Transaction {
  id              String   @id @default(cuid())
  type            String   // INCOME, EXPENSE
  category        String   // IURAN_BULANAN, IURAN_RONDA, DENDA, JIMPITAN, PEMBELIAN, PEMBANGUNAN, LAIN_LAIN
  amount          Int      // dalam Rupiah
  description     String
  date            String   // YYYY-MM-DD
  selapananId     String?
  createdBy       String   // userId
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  selapanan       Selapanan? @relation(fields: [selapananId], references: [id])
}

model Fine {
  id          String   @id @default(cuid())
  userId      String
  familyId    String
  type        String   // RONDA, JIMPITAN, LAIN_LAIN
  amount      Int      // dalam Rupiah
  reason      String
  status      String   @default("UNPAID") // UNPAID, PAID
  date        String   // YYYY-MM-DD
  selapananId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User    @relation(fields: [userId], references: [id])
  family      Family  @relation(fields: [familyId], references: [id])
}

// ============================================
// PENGUMUMAN
// ============================================

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  isPinned    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdBy   String?  // userId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User?    @relation("AnnouncementAuthor", fields: [createdBy], references: [id])
}

// ============================================
// INVENTARIS
// ============================================

model Inventory {
  id          String   @id @default(cuid())
  name        String
  quantity    Int      @default(1)
  condition   String   @default("BAIK") // BAIK, RUSAK_RINGAN, RUSAK_BERAT
  location    String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// SURAT PENGANTAR
// ============================================

model Letter {
  id          String   @id @default(cuid())
  letterNumber String?  // Nomor surat
  type        String   // DOMISILI, PENGANTAR, KETERANGAN, LAIN_LAIN
  purpose     String   // Keperluan surat
  userId      String   // Pemohon
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
}

// ============================================
// TARIKAN LAIN (CUSTOM LEVY) — digenerate admin
// ============================================

model CustomLevy {
  id          String   @id @default(cuid())
  name        String   // Nama program tarikan
  description String?
  isActive    Boolean  @default(true) // false = program berakhir (semua lunas)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       CustomLevyItem[]
}

model CustomLevyItem {
  id              String   @id @default(cuid())
  levyId          String
  familyId        String
  totalAmount     Int      // Total yang harus dibayar
  installments    Int      @default(1) // 1, 2, atau 3x cicilan
  perInstallment  Int      // totalAmount / installments
  paidAmount      Int      @default(0)
  paidInstallments Int     @default(0)
  status          String   @default("ACTIVE") // ACTIVE, COMPLETED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  levy            CustomLevy          @relation(fields: [levyId], references: [id])
  family          Family              @relation(fields: [familyId], references: [id])
  payments        CustomLevyPayment[]
}

model CustomLevyPayment {
  id                String   @id @default(cuid())
  itemId            String
  selapananId       String?
  amount            Int      // Jumlah yang dibayar
  installmentNumber Int      // Cicilan ke-berapa
  notes             String?
  createdAt         DateTime @default(now())

  item              CustomLevyItem @relation(fields: [itemId], references: [id])
  selapanan         Selapanan?     @relation(fields: [selapananId], references: [id])
}

// ============================================
// SETTINGS (PENGATURAN)
// ============================================

model Settings {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
